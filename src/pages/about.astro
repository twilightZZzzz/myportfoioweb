---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { siteConfig } from '../data/site';
import { services } from '../data/services';
import { generalProcess, principles } from '../data/home';
import { getOwnerPhoto } from '../lib/photo';

const photo = await getOwnerPhoto();
const name = siteConfig.name;
const title = name ? `${name} — ${siteConfig.role.toLowerCase()}` : 'Обо мне';
---

<Base
  title="Обо мне"
  description={`${name ? name + ', ' : ''}${siteConfig.role.toLowerCase()} из города ${siteConfig.city}. Разработка сайтов, автоматизация, Telegram-боты и интеграции для бизнеса ${siteConfig.workArea}.`}
>
  <PageHero
    title={title}
    lead={`Живу в городе ${siteConfig.city}, работаю с заказчиками ${siteConfig.workArea}. Разрабатываю сайты и цифровые инструменты, которые решают конкретные задачи бизнеса.`}
    crumbs={[{ label: 'Обо мне' }]}
  >
    <Button href="/contact" arrow>Обсудить проект</Button>
  </PageHero>

  <section class="section">
    <div class="container intro">
      {
        photo && (
          <div class="intro__photo">
            <Image src={photo} alt={`${name} — фото`} widths={[360, 720]} sizes="(max-width: 860px) 80vw, 360px" loading="eager" />
          </div>
        )
      }
      <div class="intro__text">
        <h2 class="h2">Подход к работе</h2>
        {siteConfig.about.experience && <p class="lead">{siteConfig.about.experience}</p>}
        <ul class="dash-list principles">
          {principles.map(p => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ai-title">
    <div class="container ai">
      <div class="section-head">
        <p class="eyebrow">Инструменты</p>
        <h2 id="ai-title" class="h2">Как я использую ИИ в работе</h2>
      </div>
      <div class="ai__text prose">
        <p>
          В разработке я использую Claude Code и Codex — ИИ-инструменты для программистов. Они помогают быстрее разбираться в коде, писать типовые части,
          искать ошибки и проверять варианты решения.
        </p>
        <p>
          Это инструмент, а не замена инженерной работы. Архитектуру, решения и итоговый код проверяю и принимаю я, и отвечаю за то, чтобы проект работал. Код
          проходит проверку типов, тесты и ручное тестирование перед сдачей.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="comp-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Компетенции</p>
        <h2 id="comp-title" class="h2">Чем я занимаюсь</h2>
      </div>
      <div class="grid-2">
        {
          services.map((s, i) => (
            <a class="card comp" href={`/services/${s.slug}`} data-reveal style={`--i:${i % 2}`}>
              <h3>{s.title}</h3>
              <p>{s.card.text}</p>
            </a>
          ))
        }
      </div>
      {
        siteConfig.stack.length > 0 && (
          <div class="stack">
            <h3 class="h3">Технический стек</h3>
            <dl>
              {siteConfig.stack.map(g => (
                <div>
                  <dt class="eyebrow">{g.group}</dt>
                  <dd>{g.items.join(', ')}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="collab-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Сотрудничество</p>
        <h2 id="collab-title" class="h2">Как мы будем работать</h2>
      </div>
      <ProcessSteps steps={generalProcess} />
    </div>
  </section>

  <CtaBlock />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: start;
  }
  .intro__photo {
    width: clamp(220px, 26vw, 360px);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .intro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro__text {
    display: grid;
    gap: var(--s-5);
    max-width: 820px;
  }
  .principles {
    gap: var(--s-3);
    font-size: 18px;
  }
  .ai {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-7);
  }
  .ai .section-head {
    margin: 0;
  }
  .ai__text {
    font-size: 18px;
  }
  .comp {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
    transition: border-color 0.3s;
  }
  .comp:hover {
    border-color: var(--accent);
  }
  .stack {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-4);
  }
  .stack dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--s-4);
  }
  .stack dd {
    margin: var(--s-2) 0 0;
  }
  @media (max-width: 860px) {
    .intro,
    .ai {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
