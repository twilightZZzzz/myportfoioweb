---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import CaseVideo from '../../components/CaseVideo.astro';
import { getProjects, categoryLabels, type Project } from '../../lib/projects';
import { render } from 'astro:content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next?: Project;
}
const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  description: p.summary,
  datePublished: p.publishedAt.toISOString().slice(0, 10),
  genre: categoryLabels[p.category],
};
---

<Base title={`${p.title} — ${p.type}`} description={p.summary} ogType="article" jsonLd={ld}>
  <article>
    <header class="case-hero">
      <div class="container case-hero__inner">
        <Breadcrumbs items={[{ href: '/projects', label: 'Проекты' }, { label: p.title }]} />
        <div class="case-hero__meta">
          <StatusBadge status={p.status} />
          <span class="eyebrow">{categoryLabels[p.category]} · {p.industry} · {p.type}</span>
        </div>
        <h1 class="h1">{p.title}</h1>
        <p class="lead">{p.summary}</p>
        {
          (p.demoUrl || p.repoUrl) && (
            <div class="case-hero__links">
              {p.demoUrl && (
                <Button href={p.demoUrl} target="_blank" rel="noopener" arrow data-magnetic>
                  {p.status === 'demo' ? 'Открыть демо' : 'Открыть сайт'}
                </Button>
              )}
              {p.repoUrl && (
                <Button href={p.repoUrl} target="_blank" rel="noopener" variant="secondary">
                  Репозиторий
                </Button>
              )}
            </div>
          )
        }
      </div>
    </header>

    {
      p.video ? (
        <div class="container case-cover">
          <div class="case-video" data-reveal>
            <CaseVideo mp4={p.video.mp4} mp4Small={p.video.mp4Small} poster={p.video.poster} label={p.video.label} priority />
          </div>
        </div>
      ) : (
        p.cover && (
          <div class="container case-cover">
            <Image src={p.cover.src} alt={p.cover.alt} widths={[800, 1280, 1920]} sizes="(max-width: 1340px) 100vw, 1240px" loading="eager" fetchpriority="high" />
          </div>
        )
      )
    }

    <div class="container case-body">
      <aside class="case-facts" aria-label="Коротко о проекте">
        <dl>
          <div><dt>Статус</dt><dd>{p.status === 'demo' ? 'Демонстрационный' : 'Коммерческий'}</dd></div>
          <div><dt>Отрасль</dt><dd>{p.industry}</dd></div>
          <div><dt>Тип</dt><dd>{p.type}</dd></div>
          <div><dt>Роль</dt><dd>{p.role}</dd></div>
          {p.stack.length > 0 && <div><dt>Стек</dt><dd>{p.stack.join(', ')}</dd></div>}
        </dl>
      </aside>

      <div class="case-content">
        <section class="case-section">
          <h2>Контекст и задача</h2>
          {p.challengeSimulated && <p class="case-note">Задача смоделирована для демонстрации: проект сделан не по заказу клиента.</p>}
          <p>{p.challenge}</p>
        </section>

        {
          p.requirements.length > 0 && (
            <section class="case-section">
              <h2>Что нужно было реализовать</h2>
              <ul class="dash-list">
                {p.requirements.map(r => (
                  <li>{r}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="case-section">
          <h2>Роль и решение</h2>
          <p><b>Роль:</b> {p.role}</p>
          <p>{p.solution}</p>
        </section>

        {
          p.decisions.length > 0 && (
            <section class="case-section">
              <h2>Процесс и проектные решения</h2>
              <div class="case-cards">
                {p.decisions.map(d => (
                  <div class="card">
                    <h3>{d.title}</h3>
                    <p>{d.text}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          p.features.length > 0 && (
            <section class="case-section">
              <h2>Функции и сценарии</h2>
              <div class="case-cards">
                {p.features.map(f => (
                  <div class="card">
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          hasBody && (
            <section class="case-section prose">
              <Content />
            </section>
          )
        }
      </div>
    </div>

    {
      p.images.length > 0 && (
        <section class="section" aria-labelledby="gallery-title">
          <div class="container">
            <h2 id="gallery-title" class="h2 case-h2">
              Интерфейсы
            </h2>
            <ProjectGallery images={p.images} />
          </div>
        </section>
      )
    }

    {
      (p.architecture || p.integrations.length > 0) && (
        <section class="section" aria-labelledby="arch-title">
          <div class="container">
            <h2 id="arch-title" class="h2 case-h2">
              Архитектура и интеграции
            </h2>
            {p.architecture?.text && <p class="lead case-lead">{p.architecture.text}</p>}
            {p.architecture && p.architecture.steps.length > 0 && <FlowDiagram steps={p.architecture.steps} label="Схема данных" />}
            {p.integrations.length > 0 && (
              <ul class="case-int">
                {p.integrations.map(i => (
                  <li>
                    <b>{i.name}</b>
                    <span class="text-2">{i.purpose}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      )
    }

    {
      (p.testing || p.outcome.length > 0) && (
        <section class="section" aria-label="Тестирование и результат">
          <div class="container grid-2">
            {p.testing && (p.testing.done.length > 0 || p.testing.limitations.length > 0) && (
              <div class="card">
                <h2 class="h3">Тестирование и ограничения</h2>
                {p.testing.done.length > 0 && (
                  <>
                    <p class="eyebrow case-sub">Что проверено</p>
                    <ul class="dash-list">
                      {p.testing.done.map(x => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </>
                )}
                {p.testing.limitations.length > 0 && (
                  <>
                    <p class="eyebrow case-sub">Ограничения</p>
                    <ul class="dash-list">
                      {p.testing.limitations.map(x => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            )}
            {p.outcome.length > 0 && (
              <div class="card">
                <h2 class="h3">Результат</h2>
                <p class="eyebrow case-sub">Что реализовано</p>
                <ul class="dash-list">
                  {p.outcome.map(x => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }
  </article>

  {
    next && (
      <nav class="section case-next" aria-label="Следующий проект">
        <div class="container">
          <a href={`/projects/${next.id}`}>
            <span class="eyebrow">Следующий проект</span>
            <span class="case-next__title">{next.data.title} →</span>
          </a>
        </div>
      </nav>
    )
  }

  <CtaBlock title="Хочу похожее решение" text="Расскажите о своей задаче — обсудим, как адаптировать подход под ваш бизнес." cta="Обсудить проект" />
</Base>

<style>
  .case-hero {
    padding: clamp(var(--s-7), 6vw, var(--s-9)) 0 var(--s-7);
  }
  .case-hero__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .case-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
  }
  .case-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .case-video {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .case-cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }
  .case-body {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--s-8);
    padding-block: var(--section);
  }
  .case-facts dl {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }
  .case-facts dt {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-facts dd {
    margin: 2px 0 0;
  }
  .case-content {
    display: grid;
    gap: var(--s-8);
    max-width: 820px;
  }
  .case-section {
    display: grid;
    gap: var(--s-4);
  }
  .case-section h2 {
    font-size: clamp(26px, 2.8vw, 36px);
  }
  .case-section > p {
    color: var(--text-2);
    font-size: 18px;
  }
  .case-note {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid #f3c46b;
    background: rgba(243, 196, 107, 0.07);
    color: var(--text) !important;
    font-size: var(--fs-small) !important;
  }
  .case-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-3);
  }
  .case-cards p {
    margin-top: var(--s-2);
  }
  .case-h2 {
    margin-bottom: var(--s-6);
  }
  .case-lead {
    margin-bottom: var(--s-7);
  }
  .case-int {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 0 var(--s-6);
  }
  .case-int li {
    display: grid;
    gap: 4px;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .case-sub {
    margin: var(--s-5) 0 var(--s-3);
  }
  .case-next a {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
  }
  .case-next__title {
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    transition: color 0.3s;
  }
  .case-next a:hover .case-next__title {
    color: var(--accent);
  }
  @media (max-width: 960px) {
    .case-body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }
    .case-facts dl {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
