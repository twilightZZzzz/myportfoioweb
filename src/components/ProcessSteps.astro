---
import type { Step } from '../data/types';

interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<div class="process" data-process>
  <div class="process__line" aria-hidden="true"><span data-process-fill></span></div>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class="step" data-process-step>
          <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step__title">{s.label}</h3>
          {s.note && <p class="step__note">{s.note}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process {
    position: relative;
  }
  .process__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--line-strong);
  }
  .process__line span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(1);
    box-shadow: 0 0 12px rgba(255, 90, 43, 0.6);
  }
  :global(.motion) .process__line span {
    transform: scaleX(0);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--s-5);
  }
  .step {
    position: relative;
    padding-top: var(--s-6);
  }
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .step__n {
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
    transition: color 0.4s;
  }
  .step__title {
    margin-top: var(--s-3);
    font-size: clamp(22px, 2.2vw, 32px);
    letter-spacing: -0.035em;
    color: var(--muted);
    transition: color 0.5s;
  }
  .step__note {
    margin-top: var(--s-2);
    color: var(--muted);
    font-size: var(--fs-small);
    transition: color 0.5s;
  }
  /* без анимации все шаги сразу «включены» */
  :global(html:not(.motion)) .step,
  .step.is-active {
    --on: 1;
  }
  :global(html:not(.motion)) .step::before,
  .step.is-active::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  :global(html:not(.motion)) .step .step__n,
  .step.is-active .step__n {
    color: var(--accent);
  }
  :global(html:not(.motion)) .step .step__title,
  .step.is-active .step__title {
    color: var(--text);
  }
  :global(html:not(.motion)) .step .step__note,
  .step.is-active .step__note {
    color: var(--text-2);
  }
  @media (max-width: 700px) {
    .process__line {
      display: none;
    }
    .steps {
      border-left: 1px solid var(--line-strong);
      padding-left: var(--s-5);
      gap: var(--s-5);
    }
    .step {
      padding-top: 0;
    }
    .step::before {
      left: calc(-1 * var(--s-5) - 6px);
      top: 4px;
    }
  }
</style>
