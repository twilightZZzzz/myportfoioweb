---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  mp4: string;
  mp4Small?: string;
  poster: ImageMetadata;
  label: string;
  /** eager — для главного видео страницы кейса */
  priority?: boolean;
  class?: string;
}
const { mp4, mp4Small, poster, label, priority = false, class: cls } = Astro.props;
const posterImg = await getImage({ src: poster, width: 1600, format: 'webp' });
---

<div class:list={['cv', cls]} data-case-video>
  <video
    muted
    loop
    playsinline
    preload={priority ? 'metadata' : 'none'}
    poster={posterImg.src}
    aria-label={label}
    data-src={mp4}
    data-src-small={mp4Small}
  ></video>
  <button type="button" class="cv__play" data-cv-play hidden aria-label="Воспроизвести видео">▶</button>
</div>

<style>
  .cv {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0a1812;
  }
  .cv video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cv__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    border-radius: 50%;
    border: 0;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 26px;
    cursor: pointer;
  }
</style>

<script>
  // Видео грузится и играет только в зоне видимости; без звука, по кругу.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const small = matchMedia('(max-width: 860px)').matches;

  document.querySelectorAll<HTMLElement>('[data-case-video]').forEach(box => {
    const video = box.querySelector('video')!;
    const playBtn = box.querySelector<HTMLButtonElement>('[data-cv-play]')!;
    const load = () => {
      if (video.src) return;
      video.src = (small && video.dataset.srcSmall) || video.dataset.src!;
    };

    if (reduce) {
      // без автозапуска: постер + кнопка
      playBtn.hidden = false;
      playBtn.addEventListener('click', () => {
        load();
        video.controls = true;
        playBtn.hidden = true;
        void video.play();
      });
      return;
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry!.isIntersecting) {
          load();
          void video.play().catch(() => (playBtn.hidden = false));
        } else video.pause();
      },
      { threshold: 0.25 },
    );
    io.observe(box);
    playBtn.addEventListener('click', () => {
      playBtn.hidden = true;
      void video.play();
    });
  });
</script>
