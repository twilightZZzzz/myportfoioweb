---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { images } = Astro.props;
const full = await Promise.all(images.map(img => getImage({ src: img.src, width: Math.min(img.src.width, 1920) })));
---

<div class="gallery" data-gallery>
  {
    images.map((img, i) => (
      <figure class="gallery__item" data-reveal style={`--i:${i % 2}`}>
        <button type="button" class="gallery__open" data-index={i} data-full={full[i]!.src} data-alt={img.alt} data-caption={img.caption ?? ''}>
          <Image src={img.src} alt={img.alt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" />
          <span class="sr-only">Открыть изображение крупно</span>
        </button>
        {img.caption && <figcaption class="muted">{img.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Просмотр изображения">
  <img alt="" data-lightbox-img />
  <p class="lightbox__caption" data-lightbox-caption></p>
  <div class="lightbox__nav">
    <button type="button" data-lightbox-prev aria-label="Предыдущее изображение">←</button>
    <button type="button" data-lightbox-next aria-label="Следующее изображение">→</button>
    <button type="button" data-lightbox-close aria-label="Закрыть">✕</button>
  </div>
</dialog>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .gallery__item {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }
  .gallery__item:first-child {
    grid-column: 1 / -1;
  }
  .gallery__open {
    display: block;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
  }
  .gallery__open :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.8s var(--ease);
  }
  .gallery__open:hover :global(img) {
    transform: scale(1.02);
  }
  .lightbox {
    width: min(1400px, 96vw);
    max-height: 94vh;
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .lightbox img {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }
  .lightbox__caption {
    margin-top: var(--s-3);
    color: var(--text-2);
  }
  .lightbox__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .lightbox__nav button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: none;
    cursor: pointer;
    font-size: 18px;
  }
  .lightbox__nav button:hover {
    border-color: var(--accent);
  }
  @media (max-width: 860px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('[data-full]')];
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const b = items[current]!;
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      caption.textContent = b.dataset.caption ?? '';
    };

    items.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', e => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
    if (items.length < 2) dialog.querySelectorAll<HTMLElement>('[data-lightbox-prev], [data-lightbox-next]').forEach(el => (el.hidden = true));
  });
</script>
